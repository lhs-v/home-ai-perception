tools/slots.js.json
tools/slot06.json
tools/*.workflow.js
app/data/clips.raw.json
app/data/validation.json
app/data/validation.txt
app/data/_extract.log

# ── 일반 ────────────────────────────────────────────────────
node_modules/
__pycache__/
*.pyc
.DS_Store
Thumbs.db
*.log
.env
.env.local

